# Required: Supabase project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server
NODE_ENV=development
PORT=3000

# Optional: frontend URL for CORS
# FRONTEND_URL=http://localhost:5173

# Optional: token encryption (generate with scripts/generate-encryption-key.js)
# TOKEN_ENCRYPTION_KEY=

# Optional: Meta / Google Ads OAuth (if using platform connect)
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=
# GOOGLE_ADS_CLIENT_ID=
# GOOGLE_ADS_CLIENT_SECRET=
# GOOGLE_ADS_REDIRECT_URI=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# Google Ads REST path segment (default v23 if unset). Bump when Google deprecates a version.
# GOOGLE_ADS_API_VERSION=v23
# MCC Manager Account ID — only needed if the ad account sits under a Google Ads manager account.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Set to "true" to log raw GAQL queries and first-row keys. Debugging only, never in production.
# GOOGLE_ADS_DEBUG=
# Merchant Center OAuth redirect URI (must be registered in Google Cloud Console).
# Uses the same GOOGLE_ADS_CLIENT_ID/SECRET. Required for Shopping ad image enrichment.
# GOOGLE_MC_REDIRECT_URI=

# TikTok Marketing API (Advertiser OAuth) — optional
# TIKTOK_ENABLED=true
# TIKTOK_APP_ID=
# TIKTOK_SECRET=
# TIKTOK_ADVERTISER_AUTH_URL=https://ads.tiktok.com/marketing_api/auth
# TIKTOK_ADVERTISER_REDIRECT_URI=https://your-public-host/v1/platforms/tiktok/callback
# TIKTOK_ACCOUNT_HOLDER_AUTH_URL=
# TIKTOK_ACCOUNT_HOLDER_REDIRECT_URI=
# TIKTOK_API_BASE_URL=https://business-api.tiktok.com
# TIKTOK_FRONTEND_SUCCESS_URL=
# TIKTOK_FRONTEND_ERROR_URL=

# Anthropic API Key
# ANTHROPIC_API_KEY=
